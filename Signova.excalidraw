      "link": null,
      "locked": false,
      "fontSize": 23,
      "fontFamily": 2,
      "text": "P0: alphabet mode, camera/upload, confirm/delete/space, low-confidence feedback, reproducible evaluation.\nP1: 10–20 isolated words after the Nov 6 data gate.\nP2: larger vocabulary, practice mode, speech output.\nContinuous sentence recognition stays outside this deadline.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "P0: alphabet mode, camera/upload, confirm/delete/space, low-confidence feedback, reproducible evaluation.\nP1: 10–20 isolated words after the Nov 6 data gate.\nP2: larger vocabulary, practice mode, speech output.\nContinuous sentence recognition stays outside this deadline.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
