      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Basel + osama: data loader, labels and split checks.\nBasel + Pavly: clip order, signer IDs and missing landmarks.\nOsama + Ali : parity for alphabet model and transforms.\nPavly + Ali : sequence schema and word bundle.\nAli + Adham: reconnects, unknown state and mode reset.\nHisham+ all: rehearse a user flow on a fresh machine.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Basel + osama: data loader, labels and split checks.\nBasel + Pavly: clip order, signer IDs and missing landmarks.\nOsama + Ali : parity for alphabet model and transforms.\nPavly + Ali : sequence schema and word bundle.\nAli + Adham: reconnects, unknown state and mode reset.\nHisham+ all: rehearse a user flow on a fresh machine.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
