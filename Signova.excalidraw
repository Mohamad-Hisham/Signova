      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Alphabet: crop → resize → match channels/range to training. Retain a CNN path if landmarks fail on small images.\nWords: timestamped RGB → MediaPipe two hands + selected upper-body joints. Preserve hand/body relative positions;\nadd presence masks and save missing-data rates.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Alphabet: crop → resize → match channels/range to training. Retain a CNN path if landmarks fail on small images.\nWords: timestamped RGB → MediaPipe two hands + selected upper-body joints. Preserve hand/body relative positions;\nadd presence masks and save missing-data rates.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
