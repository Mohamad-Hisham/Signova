      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "Dataset record: sample_id, path, label_id, signer_id, session_id, source_version, split. Use “unknown” when metadata is\nabsent; never invent signer IDs.\nInput: mode, request_id, capture_id, timestamp_ms, image/clip. Model features: [T, D] plus presence and time masks.\nOutput: candidate label_id, Arabic label, English label, confidence, accepted, reason, model_version and processing_ms.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dataset record: sample_id, path, label_id, signer_id, session_id, source_version, split. Use “unknown” when metadata is\nabsent; never invent signer IDs.\nInput: mode, request_id, capture_id, timestamp_ms, image/clip. Model features: [T, D] plus presence and time masks.\nOutput: candidate label_id, Arabic label, English label, confidence, accepted, reason, model_version and processing_ms.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
