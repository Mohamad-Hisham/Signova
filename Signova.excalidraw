      "fontSize": 23,
      "fontFamily": 2,
      "text": "Prefer Egyptian signs if intended users are Egyptian; confirm labels with a fluent signer. Do not pool regional\ndatasets without reviewing the signs. An English label dictionary does not require ASL training. Spelled letters and\nisolated word labels do not supply sentence grammar.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prefer Egyptian signs if intended users are Egyptian; confirm labels with a fluent signer. Do not pool regional\ndatasets without reviewing the signs. An English label dictionary does not require ASL training. Spelled letters and\nisolated word labels do not supply sentence grammar.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
