      "seed": 28934,
      "version": 3,
      "versionNonce": 1319409945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794302461731,
      "link": null,
      "locked": false,
      "fontSize": 21,
      "fontFamily": 2,
      "text": "Core: Python + OpenCV + MediaPipe + PyTorch; scikit-learn for metrics; FastAPI + WebSocket; React for UI. JSON/CSV\nexperiment logs are sufficient; MLflow and Docker are optional after integration.\nKeep large datasets and checkpoints outside Git. Commit manifests/checksums and publish versioned bundles to agreed\nstorage. No raw webcam recording by default.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core: Python + OpenCV + MediaPipe + PyTorch; scikit-learn for metrics; FastAPI + WebSocket; React for UI. JSON/CSV\nexperiment logs are sufficient; MLflow and Docker are optional after integration.\nKeep large datasets and checkpoints outside Git. Commit manifests/checksums and publish versioned bundles to agreed\nstorage. No raw webcam recording by default.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
