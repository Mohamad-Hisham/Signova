      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Member 2 proves usable files, labels, permissions and signer/session metadata. Mohab approves 10–20 word classes\nwith a fluent signer. Prefer a source with usable signer identities, not just more frames.\nIf public words fail: collect 10 words × 5 signers × 15 clips = 750 clips across two sessions; include idle and unrelated\nmotion. This is a collection target, not existing data.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Member 2 proves usable files, labels, permissions and signer/session metadata. Mohab approves 10–20 word classes\nwith a fluent signer. Prefer a source with usable signer identities, not just more frames.\nIf public words fail: collect 10 words × 5 signers × 15 clips = 750 clips across two sessions; include idle and unrelated\nmotion. This is a collection target, not existing data.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
