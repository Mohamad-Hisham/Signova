      "locked": false,
      "fontSize": 27,
      "fontFamily": 2,
      "text": "A split you can defend",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A split you can defend",
      "autoResize": true,
      "lineHeight": 1.25,
