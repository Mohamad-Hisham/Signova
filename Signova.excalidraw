      "fontSize": 23,
      "fontFamily": 2,
      "text": "Model A: a still-image CNN for supported alphabet handshapes. Compare a landmark MLP only if detection works.\nModel B: a GRU over short video sequences for isolated words. Motion, both hands and body location may carry\nmeaning. Train and evaluate the models separately.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Model A: a still-image CNN for supported alphabet handshapes. Compare a landmark MLP only if detection works.\nModel B: a GRU over short video sequences for isolated words. Motion, both hands and body location may carry\nmeaning. Train and evaluate the models separately.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
