    {
      "id": "e-00247",
      "type": "text",
      "x": 2920,
      "y": 4462,
      "width": 1154.404248046875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#183247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
