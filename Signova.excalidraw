      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "Nov 10: manifest/splits locked + mock app connected.\nNov 17: real alphabet-to-screen demo; word baseline if data passes.\nNov 24: freeze features and selected models. If a mode misses targets, narrow scope using validation evidence and\ndisclose the limitation; never tune on final test.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nov 10: manifest/splits locked + mock app connected.\nNov 17: real alphabet-to-screen demo; word baseline if data passes.\nNov 24: freeze features and selected models. If a mode misses targets, narrow scope using validation evidence and\ndisclose the limitation; never tune on final test.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
