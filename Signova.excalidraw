      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "e-00161",
      "type": "text",
      "x": 2920,
      "y": 2345.5,
      "width": 1183.2033447265624,
      "height": 110,
      "angle": 0,
      "strokeColor": "#183247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "card-00158"
      ],
      "frameId": null,
      "index": "b5k",
      "roundness": null,
      "seed": 18872,
      "version": 3,
      "versionNonce": 1397803415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794302461731,
      "link": null,
      "locked": false,
      "fontSize": 22,
      "fontFamily": 2,
      "text": "For five signers, allocate 3 train / 1 validation / 1 sealed test, with every class represented; bootstrap CIs by person/clip\nwhen enough groups exist. With very few people, report each held-out signer result.\nIf source signer IDs are unavailable, report a grouped session/clip split and its limits. A separately collected\nunseen-person webcam test is mandatory for a generalization claim.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For five signers, allocate 3 train / 1 validation / 1 sealed test, with every class represented; bootstrap CIs by person/clip\nwhen enough groups exist. With very few people, report each held-out signer result.\nIf source signer IDs are unavailable, report a grouped session/clip split and its limits. A separately collected\nunseen-person webcam test is mandatory for a generalization claim.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
