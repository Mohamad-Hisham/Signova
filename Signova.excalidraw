    {
      "id": "e-00263",
      "type": "text",
      "x": 1147,
      "y": 5156.25,
      "width": 923.8222900390624,
      "height": 460,
      "angle": 0,
      "strokeColor": "#183247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "card-00260"
      ],
      "frameId": null,
      "index": "b74",
