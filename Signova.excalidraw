    {
      "id": "e-00259",
      "type": "text",
      "x": 144,
      "y": 5156.25,
      "width": 899.3583984375,
      "height": 546.25,
      "angle": 0,
      "strokeColor": "#183247",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "card-00256"
      ],
      "frameId": null,
      "index": "b71",
