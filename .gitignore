# Signova Git safety. Owner: Hisham with Basil (data) and model owners (artifacts).
# Track approved public-safe metadata, manifests, labels, hashes and references only.
# Ignore rules do not remove already tracked files or prove a file is safe to publish.

# Secrets and local environment settings; examples contain comments, never credentials.
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
.aws/
.agents/
.codex/
.credentials/
credentials.json
secrets.json

# Environments, dependency trees, generated builds and tool caches.
.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.vite/
coverage/
htmlcov/
.coverage*
dist/
build/
*.egg-info/
*.tsbuildinfo
playwright-report/
test-results/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.log

# Offline payload layers: retain only their explanatory README and empty marker.
/data/raw/**
!/data/raw/README.md
!/data/raw/.gitkeep
/data/interim/**
!/data/interim/README.md
!/data/interim/.gitkeep
/data/processed/**
!/data/processed/README.md
!/data/processed/.gitkeep
/data/features/**
!/data/features/README.md
!/data/features/.gitkeep

# Restricted metadata, identities and raw/derived session material anywhere.
**/restricted/
**/private/
**/consent/
**/identity-mappings/
**/recordings/
**/camera-recordings/
**/captures/
**/session_dumps/
**/inference_tmp/
tmp/
temp/
/data/source_register/local/
/data/reports/local/
/ml/**/runs/
/ml/**/outputs/
/ml/**/checkpoints/
/ml/**/experiments/
/ml/**/reports/local/
/artifacts/**/weights/
/artifacts/**/checkpoints/
/artifacts/**/downloads/

# Weights, serialized objects and generated tensor/feature caches.
*.[pP][tT]
*.[pP][tT][hH]
*.[cC][kK][pP][tT]
*.[oO][nN][nN][xX]
*.[sS][aA][fF][eE][tT][eE][nN][sS][oO][rR][sS]
*.[hH]5
*.[hH][dD][fF]5
*.[kK][eE][rR][aA][sS]
*.[tT][fF][lL][iI][tT][eE]
*.[pP][bB]
*.[bB][iI][nN]
*.[pP][kK][lL]
*.[pP][iI][cC][kK][lL][eE]
*.[jJ][oO][bB][lL][iI][bB]
*.[nN][pP][yY]
*.[nN][pP][zZ]

