# Environment settings for a single worker. With the documented launch command,
# use a .env file in the repository root.

SIGNOVA_APP_NAME=Signova
SIGNOVA_ENVIRONMENT=development
SIGNOVA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SIGNOVA_REQUIRED_MODES=["alphabet"]
# Default alphabet files are in ml/alphabet/checkpoints. For a different trusted
# package, set SIGNOVA_ALPHABET_CHECKPOINT and SIGNOVA_ALPHABET_HAND_MODEL.
# Use SIGNOVA_ALPHABET_CHECKPOINT_SHA256 and SIGNOVA_ALPHABET_HAND_MODEL_SHA256
# for the package digests.
SIGNOVA_IDLE_TIMEOUT_SECONDS=900
SIGNOVA_ABSOLUTE_TIMEOUT_SECONDS=3600
SIGNOVA_RECONNECT_GRACE_SECONDS=120
SIGNOVA_END_REVIEW_SECONDS=300
SIGNOVA_SWEEP_INTERVAL_SECONDS=15
SIGNOVA_MAX_SESSIONS=20
SIGNOVA_CREATION_REQUESTS_PER_MINUTE=5
SIGNOVA_MUTATION_REQUESTS_PER_MINUTE=30
SIGNOVA_MAX_REST_BODY_BYTES=131072
SIGNOVA_MAX_JPEG_BYTES=163840
SIGNOVA_MAX_MESSAGE_BYTES=262144
SIGNOVA_MAX_JPEG_WIDTH=640
SIGNOVA_MAX_JPEG_HEIGHT=480
SIGNOVA_MAX_FPS=10
