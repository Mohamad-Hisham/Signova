# Signova scaffold — documentation placeholder; no implementation.
# Purpose: Describe future server-only runtime settings without active assignments or secrets.
# Owner: Hisham.
# Expected inputs: Approved origins, trusted model locations, runtime limits and manual policy.
# Expected outputs: Comment-only guidance for later local settings.
# Responsibilities: Explain one-worker RAM topology, exact Origin/CORS policy, startup
#   verification and content-free logs.
# Connections: config.py, main.py, adapters and local-development runbook.
# Future implementation: Choose actual setting names/values after runtime/contract decisions,
#   never browser-supplied model paths.
# Rules and limitations: No populated environment, account/auth secrets, tokens or pretend
#   approved artifact paths.
# Expected tests or acceptance: Example remains secret-free; future configuration rejects
#   incompatible rate/window/runtime requirements.

SIGNOVA_APP_NAME=Signova
SIGNOVA_ENVIRONMENT=development
SIGNOVA_CORS_ORIGINS=["http://localhost:5173"]
SIGNOVA_REQUIRED_MODES=["alphabet","word"]
SIGNOVA_IDLE_TIMEOUT_SECONDS=900
SIGNOVA_ABSOLUTE_TIMEOUT_SECONDS=3600
SIGNOVA_RECONNECT_GRACE_SECONDS=120
SIGNOVA_END_REVIEW_SECONDS=300
SIGNOVA_MAX_SESSIONS=20
SIGNOVA_MAX_JPEG_BYTES=163840
SIGNOVA_MAX_MESSAGE_BYTES=262144
SIGNOVA_MAX_JPEG_WIDTH=640
SIGNOVA_MAX_JPEG_HEIGHT=480
SIGNOVA_MAX_FPS=10
